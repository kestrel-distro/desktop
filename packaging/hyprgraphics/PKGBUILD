# Maintainer: Kestrel <https://github.com/kestrel-distro>
#
# Kestrel rebuild of `hyprgraphics` at Arch's version, compiled with clang
# -march=x86-64-v3 + ThinLTO so the whole desktop stack shares one codegen.
# Distinct package name that provides/replaces the Arch package and its soname.
#
# Build options:
#   _kestrel_march   x86-64-v3 (default)
#   _kestrel_lto     thin (default) | none

pkgname=hyprgraphics-kestrel
pkgver=0.5.1
pkgrel=1
pkgdesc='Hyprland graphics/color helpers'
arch=(x86_64)
url="https://github.com/hyprwm/hyprgraphics"
license=(BSD-3-Clause)
depends=(cairo file libgcc libstdc++ glibc hyprutils libhyprutils.so=13-64 libjpeg-turbo libjxl libpng librsvg libwebp libglvnd pango pixman)
makedepends=(cmake ninja clang llvm lld pkgconf)
provides=(hyprgraphics libhyprgraphics.so=4-64)
conflicts=(hyprgraphics)
replaces=(hyprgraphics)
options=(!debug)

: "${_kestrel_march:=x86-64-v3}"
: "${_kestrel_lto:=thin}"

_lib=hyprgraphics
source=("$pkgname-$pkgver.tar.gz::https://github.com/hyprwm/$_lib/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('861ecaad872835922dd5745a612d7a4cc7bfc4babb1d06bc92bc63c2ac013b74')

build() {
	cd "$_lib-$pkgver"
	local _cflags="-march=${_kestrel_march}"
	local _ldflags=""
	if [[ "$_kestrel_lto" == "thin" ]]; then
		_cflags+=" -flto=thin"
		_ldflags+=" -flto=thin -fuse-ld=lld"
	fi
	cmake -B build -S . -G Ninja -W no-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
		-DCMAKE_C_FLAGS="$_cflags" -DCMAKE_CXX_FLAGS="$_cflags" \
		-DCMAKE_EXE_LINKER_FLAGS="$_ldflags" -DCMAKE_SHARED_LINKER_FLAGS="$_ldflags" \
		-DCMAKE_AR="$(command -v llvm-ar)" -DCMAKE_RANLIB="$(command -v llvm-ranlib)" -DCMAKE_NM="$(command -v llvm-nm)"
	cmake --build build
}

package() {
	cd "$_lib-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	[[ -f LICENSE ]] && install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
